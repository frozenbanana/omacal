[Unit]
Description=Omarcal calendar sync and alarm daemon
After=graphical-session.target

[Service]
Type=simple
# Full app with tray; alarms and background sync stay alive
ExecStart=%h/.local/bin/omarcal
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
Environment=OMARCAL_START_HIDDEN=1

[Install]
WantedBy=default.target
