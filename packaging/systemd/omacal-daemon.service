[Unit]
Description=Omacal calendar sync and alarm daemon
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# Full app with tray; alarms and background sync stay alive
# PKGBUILD uses /usr/bin/omacal; local install uses %h/.local/bin/omacal
ExecStart=%h/.local/bin/omacal
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
Environment=OMACAL_START_HIDDEN=1

[Install]
WantedBy=graphical-session.target
