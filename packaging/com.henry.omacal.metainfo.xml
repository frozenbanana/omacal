<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.henry.omacal</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Omacal</name>
  <summary>Omarchy-native CalDAV calendar</summary>
  <description>
    <p>
      Fast, local-first calendar that syncs natively with Nextcloud CalDAV.
      No vdirsyncer, no Evolution Data Server. Live Omarchy theme reload,
      Mako notifications, tray icon, and Hyprland integration.
    </p>
    <p>
      Features day/week/month/year views, native CalDAV sync-collection,
      wall-time DST-safe recurrence (EXDATE/UNTIL), Mako alarms, and
      .ics import. Passwords stay in the system keyring.
    </p>
  </description>
  <launchable type="desktop-id">omacal.desktop</launchable>
  <provides>
    <id>omacal.desktop</id>
  </provides>
  <screenshots>
    <screenshot type="default">
      <caption>Day / Week / Month / Year views with Omarchy Nord theme</caption>
      <image>https://raw.githubusercontent.com/frozenbanana/omacal/main/packaging/screenshots/main.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/frozenbanana/omacal</url>
  <url type="bugtracker">https://github.com/frozenbanana/omacal/issues</url>
